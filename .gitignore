# Gradle and CMake build output
build/outputs/
**/.cxx/
**/.gradle/
android/build/
vr-probe/build/

# Machine-specific SDK location
local.properties

# Signing material must never be committed. Losing it means published
# APKs can no longer be updated in place, so back it up out of band.
*.keystore
*.jks
keystore.properties

# The data payload is copied into assets by the stageAssets Gradle task.
android/src/main/assets/
vr-probe/src/main/assets/

