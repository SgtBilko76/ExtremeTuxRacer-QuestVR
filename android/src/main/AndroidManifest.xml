<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          android:installLocation="auto">

    <!-- Quest: arm64 GLES 3 with 6DOF head tracking -->
    <uses-feature android:glEsVersion="0x00030000" android:required="true" />
    <uses-feature android:name="android.hardware.vr.headtracking"
                  android:version="1" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen"
                  android:required="false" />
    <uses-feature android:name="android.hardware.gamepad"
                  android:required="false" />

    <!--
        Declared solely so Horizon OS does not gate the launch behind its
        "controllers required" dialog, which otherwise blocks starting the
        app whenever the Touch controllers have gone to sleep. Gameplay
        input is still Touch-only (see src/vr/xr_input.cpp); hand tracking
        is not implemented, hence required="false".
    -->
    <uses-feature android:name="oculus.software.handtracking"
                  android:required="false" />

    <application android:label="@string/app_name"
                 android:allowBackup="false"
                 android:appCategory="game"
                 android:isGame="true"
                 android:hasCode="false"
                 android:hardwareAccelerated="true">

        <!-- Run on every headset, and keep rendering under system overlays -->
        <meta-data android:name="com.oculus.supportedDevices" android:value="all" />
        <meta-data android:name="com.oculus.vr.focusaware" android:value="true" />

        <activity android:name="android.app.NativeActivity"
                  android:label="@string/app_name"
                  android:launchMode="singleTask"
                  android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|uiMode|density"
                  android:screenOrientation="landscape"
                  android:preferMinimalPostProcessing="true"
                  android:exported="true">

            <!-- NativeActivity loads this, and libetr.so pulls in the
                 OpenXR loader as a DT_NEEDED dependency. -->
            <meta-data android:name="android.app.lib_name" android:value="etr" />

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- Launch as a native OpenXR app on Meta Quest -->
                <category android:name="com.oculus.intent.category.VR" />
                <category android:name="org.khronos.openxr.intent.category.IMMERSIVE_HMD" />
            </intent-filter>
        </activity>
    </application>
</manifest>
